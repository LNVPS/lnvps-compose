{
  "name": "lnvps-compose",
  "version": "0.1.3",
  "description": "Parser and types for the LNVPS managed-app compose YAML, matching the Rust source of truth in LNVPS/api's lnvps_compose crate.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify-dist": "bun run build && git diff --exit-code -- dist"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "typescript": "~5.7.3"
  }
}
